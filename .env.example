# ICARUS Scientific Research Engine - Environment Variables
# Copy this file to .env and fill in your credentials

# ============================================================
# Central Orchestrator & LLM Planning (Account 1: ICARUS_CORE)
# ============================================================
# Groq API for GPT-OSS-120B research orchestration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ============================================================
# Worker Tunneling & Distributed Endpoints (ngrok)
# ============================================================
# Required on each Kaggle worker notebook to expose FastAPI service
NGROK_AUTH_TOKEN=

# Dynamic or static ngrok public URLs for registered workers
ICARUS_WORKER_EO_URL=
ICARUS_WORKER_2_URL=
ICARUS_WORKER_3_URL=

# ============================================================
# Earth Observation Data Providers (Account 2: ICARUS_WORKER_EO)
# ============================================================
# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu/)
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# NASA Earthdata (https://urs.earthdata.nasa.gov/)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=

# ============================================================
# Atmosphere & Oceans Data Providers
# ============================================================
# ECMWF Climate Data Store (https://cds.climate.copernicus.eu/)
CDS_API_KEY=
CDS_API_URL=https://cds.climate.copernicus.eu/api/v2

# Copernicus Marine Service (https://marine.copernicus.eu/)
COPERNICUS_MARINE_USERNAME=
COPERNICUS_MARINE_PASSWORD=

# ============================================================
# Kaggle Secrets Integration
# ============================================================
# In Kaggle notebooks, add these keys via:
# Add-ons > Secrets > Add New Secret
# The ICARUS runtime will auto-detect Kaggle environment and read secrets.

# ============================================================
# General Engine Configuration
# ============================================================
ICARUS_OUTPUT_DIR=./outputs
ICARUS_CACHE_DIR=./cache
ICARUS_LOG_LEVEL=INFO
